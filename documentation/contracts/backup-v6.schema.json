            "income",
            "expense"
          ]
        },
        "amountMinor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        },
        "accountId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "categoryId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "note": {
          "anyOf": [

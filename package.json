{
  "name": "kwartracker",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@noble/hashes": "2.4.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@shopify/flash-list": "2.0.2",
    "expo": "~57.0.31",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "1.61.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-quick-base64": "3.0.1",
    "react-native-quick-crypto": "1.1.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client --lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "node scripts/generate-route-types.mjs && tsc --noEmit",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "check:contracts": "node scripts/generate-contracts.mjs --check",
    "test:core": "node --test --test-timeout=30000 tests/domain.test.ts tests/database.test.ts tests/guardrails.test.ts tests/restore-probe.test.ts tests/ledger.test.ts",
    "test:components": "jest --runInBand",
    "test": "npm run test:core && npm run test:components",
    "check:build": "node scripts/check-build-config.mjs",
    "check:bundle": "node scripts/check-validation-bundle.mjs"
  },
  "expo": {
    "autolinking": {
      "exclude": ["kwartracker-foundation-probes", "react-native-quick-crypto", "react-native-nitro-modules", "react-native-quick-base64"]
    }
  },
  "private": true,
  "engines": {
    "node": ">=24.13.1 <25"
  }
}
